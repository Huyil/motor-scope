__pycache__/
*.pyc
imports/

# 自带便携 Python (~30MB 二进制): 随目录拷贝/压缩分发, 不进 git.
# 想让它跟着 git 走就删掉这一行.
runtime/

# 机型工程（profiles/）里的用户数据不进 git，但 profiles/demo/ 例外。
# 注意：不能直接写 profiles/ —— 父目录一旦被忽略，git 不会进入它，
# 后面的 !profiles/demo/ 就失效了。所以按「内容」逐条忽略。
profiles/*/signals.json
profiles/*/profile.json
profiles/*/config.json
profiles/*/annotations.json
profiles/index.json
# 上面规则会误伤 profiles/demo/*.signals.json，这里放行演示表
!profiles/demo/
!profiles/demo/*.json
!profiles/demo/README.md

# OpenOCD 相关：主仓只跟踪 submodule 指针，不含二进制内容。
#   tools/openocd-cfg/       → submodule: github.com/Huyil/motor-scope-openocd-cfg（target cfg 存档）
#   tools/riscv-openocd-wch/ → submodule: github.com/Huyil/riscv-openocd-wch（WCH 定制版源码）
#   tools/openocd/           → ARM OpenOCD 0.12.0-rc2 发行版，用户自备（tools/fetch_openocd.py 下载）
#   tools/openocd-wch-fast/  → RISC-V 预编译二进制，由 tools/fetch_openocd.py 从 Release 解压
#   tools/openocd-wch/       → 旧命名，兼容
tools/openocd/
tools/openocd-wch-fast/
tools/openocd-wch/

# 手册抽取中间产物（子智能体输出，不进 git）
.work/

# 服务端分块压缩录制缓存（运行期数据，不进 git）
.record-cache/
